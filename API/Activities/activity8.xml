            </con:settings>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>https://petstore.swagger.io</con:endpoint>
            <con:request><![CDATA[{
  "id": 12345,
  "username": "testuser01",
  "firstName": "Test",
  "lastName": "User",
  "email": "testuser01@example.com",
  "password": "P@ssw0rd123",
  "phone": "1234567890",
  "userStatus": 0
}]]></con:request>
            <con:originalUri>https://petstore.swagger.io/v2/user</con:originalUri>
            <con:assertion type="Valid HTTP Status Codes" id="ee15a8b2-98f6-4c25-8d50-3268872fe6b6" name="Valid HTTP Status Codes">
              <con:settings/>
              <con:configuration>
                <codes>200</codes>
              </con:configuration>
            </con:assertion>
            <con:credentials>
              <con:selectedAuthProfile>No Authorization</con:selectedAuthProfile>
              <con:authType>No Authorization</con:authType>
            </con:credentials>
            <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
          </con:restRequest>
        </con:config>
      </con:testStep>
      <con:properties>
        <con:property>
          <con:name>username</con:name>
          <con:value>testuser01</con:value>
        </con:property>
      </con:properties>
      <con:reportParameters/>
    </con:testCase>

