    <!-- Test Case 1: POST request to create a pet -->
    <con:testCase id="c07cddd4-c44a-4d8e-a8bb-80cb6975fd95" failOnError="false" failTestCaseOnErrors="true" keepSession="false" name="1 - CreatePet (POST)" searchProperties="true" timeout="0">
      <con:settings/>
      <con:testStep type="restrequest" name="AddPet" id="23141f50-8cd5-4c8e-8c16-35f0459eb2c2">
        <con:settings/>
        <con:config service="https://petstore.swagger.io" methodName="AddPet" resourcePath="/v2/pet" xsi:type="con:RestRequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <con:restRequest name="AddPet" id="c332b791-f5d8-4804-a847-962ef7c117c0" mediaType="application/json" method="POST">
            <con:settings>
              <con:setting id="com.eviware.soapui.impl.wsdl.WsdlRequest@request-headers">&lt;xml-fragment/></con:setting>
            </con:settings>
            <con:encoding>UTF-8</con:encoding>
            <con:endpoint>https://petstore.swagger.io</con:endpoint>
            <con:request><![CDATA[{
  "id": 987654,
  "name": "Buddy",
  "status": "available"
}]]></con:request>
            <con:originalUri>https://petstore.swagger.io/v2/pet</con:originalUri>
            <con:assertion type="Valid HTTP Status Codes" id="29158f26-4c03-4a52-a7c1-2d83f9fda180" name="Valid HTTP Status Codes">
              <con:settings/>
              <con:configuration>
                <codes>200</codes>
              </con:configuration>
            </con:assertion>
            <con:credentials>
              <con:selectedAuthProfile>No Authorization</con:selectedAuthProfile>
              <con:authType>No Authorization</con:authType>
            </con:credentials>
            <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
          </con:restRequest>
        </con:config>
      </con:testStep>
      <con:testStep type="transfer" name="Transfer petId" id="319ccd15-9edc-483b-8dcf-1a67ad1b8844">
        <con:settings/>
        <con:config xsi:type="con:XQueryTransferStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
          <con:transfer name="petId" xsi:type="con:PropertyTransfer">
            <con:sourceStep>AddPet</con:sourceStep>
            <con:sourceProperty>Response</con:sourceProperty>
            <con:sourcePath>$['id']</con:sourcePath>
            <con:sourceType>JSONPath</con:sourceType>
            <con:targetStep>#TestCase#</con:targetStep>
            <con:targetProperty>petId</con:targetProperty>
          </con:transfer>
        </con:config>
      </con:testStep>
      <con:properties>
        <con:property>
          <con:name>petId</con:name>
          <con:value/>
        </con:property>
      </con:properties>
      <con:reportParameters/>
    </con:testCase>

