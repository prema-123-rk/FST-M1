<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config" id="4cada37f-c5c4-487e-8cf8-efabf66380f5" activeEnvironment="Default" name="PetStoreProject" resourceRoot="">
  <con:testSuite id="66a6e404-48b0-4499-8e67-6faf252bd86c" name="Activity1">
    <con:settings/>
